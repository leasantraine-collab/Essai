{
  "name": "carnet-ifsi",
  "version": "1.1.0",
  "private": true,
  "description": "Carnet IFSI : fiches, cours, quiz et calculs de doses pour réviser en IFSI (Android, iOS et web).",
  "scripts": {
    "serve": "npx --yes http-server www -p 8080 -c-1",
    "sync": "npx cap sync",
    "android": "npx cap open android",
    "ios": "npx cap open ios",
    "assets": "npx capacitor-assets generate --iconBackgroundColor '#123B4A' --iconBackgroundColorDark '#0B1E26' --splashBackgroundColor '#F6F4EF' --splashBackgroundColorDark '#0E1519'"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.6.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.0",
    "@fontsource-variable/source-serif-4": "^5.2.0"
  }
}
